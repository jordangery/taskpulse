# ============================================
# Day 1 - Local SQLite (no auth needed)
# ============================================

DATABASE_URL="file:./dev.db"

# 開發階段切換身分用（避免每次重啟都要登入）
# 設成 cuid 字串，對應 seed.ts 建立的使用者
# 跑 npx prisma db seed 後會 print 出每個 user 的 cuid
DEV_CURRENT_USER_ID=""


# ============================================
# Day 2 - NextAuth (Google OAuth)
# ============================================

# openssl rand -base64 32
AUTH_SECRET=""

# 從 Google Cloud Console 拿
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 本地用 http://localhost:3000；線上改成 https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"


# ============================================
# Day 2 - Turso (若採用，否則保持註解)
# ============================================

# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""


# ============================================
# Phase D - Atlassian Jira 整合（選用）
# ============================================
# 沒設也能跑：dashboard Jira widget 會顯示「尚未設定」
# 在 https://developer.atlassian.com/console/myapps/ 建一個 OAuth 2.0 (3LO) app
# Scopes: read:jira-work read:jira-user offline_access
# Callback URL: http://localhost:3000/api/auth/callback/atlassian
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""
# 預設關閉寫入（建/改 issue + comment + transition）— 只讀取 Jira 票
# 想開：=true（auth.config.ts scope 要同時加 write:jira-work、Developer Console 也要勾、user 要重連 Atlassian）
ATLASSIAN_WRITE_ENABLED="false"

# Dashboard 頂部「專案版號」要顯示哪些 project
# 空：自動從 team Jira 撈到的票推導（最常用）
# "*"：顯示全部 (最多 50 個)
# "BB1,YY1,HEYT"：精確指定 project key list
JIRA_VERSION_PROJECT_KEYS=""
