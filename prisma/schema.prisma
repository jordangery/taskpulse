// taskpulse - prisma/schema.prisma
// Day 1：所有 model 都會用到，但 Account / Session 在 Day 2 NextAuth 才會運作
// 為了避免 Day 2 再做一次 migration，Day 1 直接全部 schema 都建好

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  role          Role             @default(member)
  createdAt     DateTime         @default(now())
  archivedAt    DateTime?        // 軟刪除：避免任務 assignee 變成孤兒

  // Day 2 NextAuth
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // 關聯
  assignedTasks Task[]           @relation("Assignee")
  createdTasks  Task[]           @relation("Creator")
  updates       ProgressUpdate[]
  feedbacks     Feedback[]
  notifications Notification[]

  @@index([archivedAt])
}

model Task {
  id            String           @id @default(cuid())
  title         String
  description   String?
  assigneeId    String
  assignee      User             @relation("Assignee", fields: [assigneeId], references: [id])
  creatorId     String
  creator       User             @relation("Creator", fields: [creatorId], references: [id])
  dueDate       DateTime?
  createdAt     DateTime         @default(now())
  archivedAt    DateTime?

  updates       ProgressUpdate[]
  notifications Notification[]

  @@index([assigneeId])
  @@index([archivedAt])
}

// 進度摘要：append-only 歷史紀錄
// 任務「最新狀態」= 最新一筆 ProgressUpdate（依 createdAt desc）
model ProgressUpdate {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  summary    String
  percentage Int?
  status     String?
  createdAt  DateTime @default(now())

  feedbacks  Feedback[]

  @@index([taskId, createdAt])
  @@index([authorId])
}

// 回饋 / 留言（已從 1對1 改為多對一，使用者要求改成留言板）
// 每筆 ProgressUpdate 可掛多個 Feedback，author 可以是 admin 或 member
// 編輯權限：只有該則 author 能改自己的，updatedAt 自動更新
// （spec 原本說「❌ 組員回應主管的回饋」「✅ 一筆 ProgressUpdate 最多一條 Feedback」都已推翻）
model Feedback {
  id               String         @id @default(cuid())
  progressUpdateId String
  progressUpdate   ProgressUpdate @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id])
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([progressUpdateId, createdAt])
}

// App 內通知（4 種事件：task_assigned / feedback_received / progress_received / due_warning）
// 收件人 = recipientId；message 在建立時 pre-render 成字串、link 是點下要跳的 URL
// readAt = null 為未讀，計 badge 數靠這個欄位
// type 用字串而非 enum，方便未來加類型不必 migration
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String    // task_assigned | feedback_received | progress_received
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message     String
  link        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([createdAt])
}

// ----- NextAuth (Day 2) -----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
