// taskpulse - prisma/schema.prisma
// Day 1：所有 model 都會用到，但 Account / Session 在 Day 2 NextAuth 才會運作
// 為了避免 Day 2 再做一次 migration，Day 1 直接全部 schema 都建好

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  role          Role             @default(member)
  createdAt     DateTime         @default(now())
  archivedAt    DateTime?        // 軟刪除：避免任務 assignee 變成孤兒

  // Day 2 NextAuth
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // 關聯
  assignedTasks TaskAssignee[]   // 一個 user 可能被分派到多個 task（many-to-many via TaskAssignee）
  createdTasks  Task[]           @relation("Creator")
  updates       ProgressUpdate[]
  feedbacks     Feedback[]
  notifications Notification[]
  calendarNotes CalendarNote[]

  @@index([archivedAt])
}

// 日曆記事：跟 Task/Jira 無關的純文字小備忘，掛在某一天上
// 用途：請假 / 開會 / 出差 / 國定假日備註 / 任何想記但不適合開單的事
// 權限：任何 user 都可建；只有 author 自己能編輯；author 或 admin 都可刪
// 可見性：team 共享（沒做 personal/team flag — 小團隊用一鍋共享比較單純）
model CalendarNote {
  id        String   @id @default(cuid())
  dateKey   String   // YYYY-MM-DD（local time）；用 string 而非 DateTime 避免時區出包
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateKey])
  @@index([authorId])
}

model Task {
  id            String           @id @default(cuid())
  title         String
  description   String?
  // 多人指派：透過 TaskAssignee join table，taskpulse 端把每位 assignee 視為平等的工作擁有者
  // Jira sync 時用「第一位」作為 Jira issue 的 assignee（Jira 只支援單一 assignee）
  assignees     TaskAssignee[]
  creatorId     String
  creator       User             @relation("Creator", fields: [creatorId], references: [id])
  dueDate       DateTime?
  createdAt     DateTime         @default(now())
  archivedAt    DateTime?
  completedAt   DateTime?

  // Jira sync（taskpulse 是 source of truth；建 task 後嘗試 push 到 Jira）
  // 狀態：
  //   key=null  error=null   → 未嘗試（剛建好或之前失敗清掉）
  //   key=null  error="..."  → 失敗
  //   key="X"   syncedAt=t   → 已同步
  jiraIssueKey     String?   @unique
  jiraSyncedAt     DateTime?
  jiraSyncError    String?
  jiraSyncAttempts Int       @default(0)

  updates       ProgressUpdate[]
  notifications Notification[]

  @@index([archivedAt])
  @@index([completedAt])
  @@index([jiraIssueKey])
}

// Task ↔ User many-to-many（多人指派）
// 順序由 createdAt asc 還原：先選的人視為 primary assignee（Jira sync 時用）
model TaskAssignee {
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

// 進度摘要：append-only 歷史紀錄
// 任務「最新狀態」= 最新一筆 ProgressUpdate（依 createdAt desc）
model ProgressUpdate {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  summary    String
  percentage Int?
  status     String?
  createdAt  DateTime @default(now())

  feedbacks  Feedback[]

  @@index([taskId, createdAt])
  @@index([authorId])
}

// 回饋 / 留言（已從 1對1 改為多對一，使用者要求改成留言板）
// 每筆 ProgressUpdate 可掛多個 Feedback，author 可以是 admin 或 member
// 編輯權限：只有該則 author 能改自己的，updatedAt 自動更新
// （spec 原本說「❌ 組員回應主管的回饋」「✅ 一筆 ProgressUpdate 最多一條 Feedback」都已推翻）
model Feedback {
  id               String         @id @default(cuid())
  progressUpdateId String
  progressUpdate   ProgressUpdate @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id])
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([progressUpdateId, createdAt])
}

// App 內通知（4 種事件：task_assigned / feedback_received / progress_received / due_warning）
// 收件人 = recipientId；message 在建立時 pre-render 成字串、link 是點下要跳的 URL
// readAt = null 為未讀，計 badge 數靠這個欄位
// type 用字串而非 enum，方便未來加類型不必 migration
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String    // task_assigned | feedback_received | progress_received
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message     String
  link        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([createdAt])
}

// ----- NextAuth (Day 2) -----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
